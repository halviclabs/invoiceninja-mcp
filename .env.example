# --- Invoice Ninja connection -------------------------------------------------
# Base URL of YOUR instance. Do NOT append /api/v1 (added automatically).
INVOICE_NINJA_URL=https://invoicing.example.ch

# Company API token: Settings > Account Management > Integrations > API Tokens
INVOICE_NINJA_TOKEN=your-company-token

# Optional. Only if you set an api_secret on the Invoice Ninja side. Not used in request-credentials mode.
# INVOICE_NINJA_SECRET=

# --- Safety -------------------------------------------------------------------
# Writes are OFF by default. Set to true to enable create/update/action tools.
# Local-file uploads are only available over stdio; HTTP never exposes in_upload_document.
INVOICE_NINJA_ALLOW_WRITES=false
# Safe mode: with writes on, leave out in_invoice_action, in_quote_action and in_create_payment and narrow
# in_task_action to archive/restore. Drafts, clients, expenses, tasks and time entries keep working; sending,
# settling, cancelling and deleting stay in Invoice Ninja. Hosts with their own approval gate run like this.
# INVOICE_NINJA_SAFE_MODE=true
# Tools never registered, comma-separated (any tool name).
# INVOICE_NINJA_DISABLED_TOOLS=in_create_product,in_create_project

# Caps rows returned to the model so list calls stay context-light.
INVOICE_NINJA_MAX_PER_PAGE=100
INVOICE_NINJA_TIMEOUT_MS=30000

# --- Remote (HTTP transport) only ---------------------------------------------
# PORT=8787
# HOST=127.0.0.1
# MCP_BEARER_TOKEN=generate-a-long-random-string
# Several accounts through one server: explicitly enable request headers behind the bearer.
# With this on, every request needs X-Invoice-Ninja-Url AND X-Invoice-Ninja-Token; it may also send
# X-Invoice-Ninja-Safe-Mode (see README). Environment URL, token and secret are not used.
# With this off (the default), all three request headers are ignored.
# INVOICE_NINJA_REQUIRE_REQUEST_CREDENTIALS=true
