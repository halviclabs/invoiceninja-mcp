# --- Invoice Ninja connection -------------------------------------------------
INVOICE_NINJA_URL=https://invoicing.example.ch
INVOICE_NINJA_TOKEN=your-company-token
# Optional API secret; used only with environment credentials.
# INVOICE_NINJA_SECRET=
# HTTP is disabled by default, including localhost. Only opt in for a trusted local/private service.
# INVOICE_NINJA_ALLOW_HTTP=true

# --- Tool policy --------------------------------------------------------------
INVOICE_NINJA_ALLOW_WRITES=false
# Drafts and ordinary updates remain available; lifecycle/payment tools are restricted.
# INVOICE_NINJA_SAFE_MODE=true
# INVOICE_NINJA_DISABLED_TOOLS=in_create_product,in_create_project

# Local stdio uploads are off unless a staging directory is configured. HTTP never exposes them.
# Stage only files intended for upload; keep this directory under operator control.
# INVOICE_NINJA_UPLOAD_DIR=/absolute/path/to/upload-staging
# INVOICE_NINJA_MAX_UPLOAD_BYTES=10485760

# Positive integer limits; invalid values fail closed.
INVOICE_NINJA_MAX_PER_PAGE=100
INVOICE_NINJA_TIMEOUT_MS=30000
INVOICE_NINJA_MAX_RESPONSE_BYTES=2097152

# --- HTTP transport -----------------------------------------------------------
# Mandatory for every HTTP server. No unauthenticated mode.
# MCP_BEARER_TOKEN=generate-a-long-random-string
# PORT=8787
# HOST=127.0.0.1
# Exact HTTP hostnames, optionally including ports. Include the public proxy name if it preserves Host.
# MCP_ALLOWED_HOSTS=127.0.0.1,localhost,[::1],invoicing-mcp.example.ch
# No browser Origins are accepted by default; native MCP clients normally omit Origin.
# MCP_ALLOWED_ORIGINS=https://your-mcp-host.example
# MCP_MAX_REQUEST_BYTES=262144
# MCP_BODY_TIMEOUT_MS=10000
# MCP_MAX_CONCURRENT_REQUESTS=16
# MCP_RATE_LIMIT_PER_MINUTE=120

# Optional multiple-account mode. BOTH headers are required on every request; environment secrets are unused.
# Every destination must match an exact operator-configured base URL, including scheme, port and path.
# No wildcards. Local/private URLs are permitted only when explicitly configured here.
# INVOICE_NINJA_REQUIRE_REQUEST_CREDENTIALS=true
# INVOICE_NINJA_ALLOWED_URLS=https://invoicing.example.ch,https://another-instance.example.ch/billing
