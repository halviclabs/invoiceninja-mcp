{
  "name": "@halviclabs/invoiceninja-mcp",
  "version": "0.3.1",
  "description": "Self-hosted MCP server for Invoice Ninja (v5). Sovereignty-friendly, no third-party SaaS bridge.",
  "homepage": "https://halvic.ch",
  "author": "Halvic Labs <hire@halvic.ch> (https://halvic.ch)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halviclabs/invoiceninja-mcp.git"
  },
  "type": "module",
  "bin": {
    "invoiceninja-mcp": "dist/index.js",
    "invoiceninja-mcp-http": "dist/http.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "invoice-ninja",
    "invoicing",
    "claude"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "proxy-addr": "^2.0.8"
  }
}
